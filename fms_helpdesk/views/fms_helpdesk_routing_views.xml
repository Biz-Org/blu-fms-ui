<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fms_helpdesk_routing_rule_list" model="ir.ui.view">
        <field name="name">fms.helpdesk.routing.rule.list</field>
        <field name="model">fms.helpdesk.routing.rule</field>
        <field name="arch" type="xml">
            <list string="Routing Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="subcategory_id"/>
                <field name="priority_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="sla_policy_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fms_helpdesk_routing_rule_form" model="ir.ui.view">
        <field name="name">fms.helpdesk.routing.rule.form</field>
        <field name="model">fms.helpdesk.routing.rule</field>
        <field name="arch" type="xml">
            <form string="Create Routing Rule" class="o_fms_helpdesk_form">
                <sheet>
                    <group string="Rule Information">
                        <field name="name" placeholder="Water Leakage Rule"/>
                        <field name="active" widget="boolean_toggle"/>
                        <field name="sequence"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="When a Complaint Matches">
                        <field name="category_id"/>
                        <field name="subcategory_id"/>
                        <field name="priority_id"/>
                    </group>
                    <group string="Then Route To">
                        <field name="team_id"/>
                        <field name="user_id"/>
                        <field name="sla_policy_id"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fms_helpdesk_routing_rule_search" model="ir.ui.view">
        <field name="name">fms.helpdesk.routing.rule.search</field>
        <field name="model">fms.helpdesk.routing.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <field name="team_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_team" string="Support Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_fms_helpdesk_routing_test_form" model="ir.ui.view">
        <field name="name">fms.helpdesk.routing.test.form</field>
        <field name="model">fms.helpdesk.routing.test</field>
        <field name="arch" type="xml">
            <form string="Test Routing">
                <sheet>
                    <group string="Sample Ticket Attributes">
                        <field name="category_id"/>
                        <field name="subcategory_id"/>
                        <field name="priority_id"/>
                    </group>
                    <group string="Evaluated Result" invisible="not result_summary">
                        <field name="rule_id"/>
                        <field name="team_id"/>
                        <field name="user_id"/>
                        <field name="sla_policy_id"/>
                        <field name="result_summary" colspan="2"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_test" type="object" string="Test Routing" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fms_helpdesk_routing_rule" model="ir.actions.act_window">
        <field name="name">Routing Rules</field>
        <field name="res_model">fms.helpdesk.routing.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fms_helpdesk_routing_rule_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <record id="action_fms_helpdesk_routing_test" model="ir.actions.act_window">
        <field name="name">Test Routing</field>
        <field name="res_model">fms.helpdesk.routing.test</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_fms_helpdesk_routing_test_form"/>
    </record>
</odoo>
