<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fms_helpdesk_team_list" model="ir.ui.view">
        <field name="name">fms.helpdesk.team.list</field>
        <field name="model">fms.helpdesk.team</field>
        <field name="arch" type="xml">
            <list string="Support Teams">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="leader_id"/>
                <field name="assignment_method"/>
                <field name="open_ticket_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_fms_helpdesk_team_form" model="ir.ui.view">
        <field name="name">fms.helpdesk.team.form</field>
        <field name="model">fms.helpdesk.team</field>
        <field name="arch" type="xml">
            <form string="Support Team">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Plumbing Team"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="leader_id"/>
                            <field name="assignment_method"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="open_ticket_count"/>
                        </group>
                    </group>
                    <group string="Members">
                        <field name="member_ids" widget="many2many_tags" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2" placeholder="What this team handles"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fms_helpdesk_team_search" model="ir.ui.view">
        <field name="name">fms.helpdesk.team.search</field>
        <field name="model">fms.helpdesk.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="leader_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_fms_helpdesk_team" model="ir.actions.act_window">
        <field name="name">Support Teams</field>
        <field name="res_model">fms.helpdesk.team</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fms_helpdesk_team_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a support team</p>
            <p>Teams receive routed tickets and hold the staff who work them.</p>
        </field>
    </record>
</odoo>
